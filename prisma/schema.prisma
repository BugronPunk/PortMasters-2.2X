// =====================================================================
// PortMasters 2.2 Parallel Release: database schema
// Prisma schema covering accounts, sessions, rooms, membership, per
// player game state, chat, captain legacy, merits, convoy ventures,
// loans, voyage chronicles, captain rivals, and house standings.
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  displayName  String
  avatarHue    Int       @default(180)
  // "captain" for everyone who signs up, "admin" for an account admitted
  // through the operator console. Read at each admin event straight from
  // this row rather than trusted from a socket, so revoking it lands on
  // the operator's next click instead of their next reconnect.
  role         String    @default("captain")
  // Set by a ban, cleared by an unban. A banned account keeps its row and
  // loses everything else: its sessions go, its seats are reaped, and each
  // of the gates that decides whether an account may act refuses it.
  bannedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions     Session[]
  memberships  RoomMember[]
  ownedRooms   Room[]         @relation("RoomHost")
  gameStates   GameState[]
  voyageRoles  VoyageRole[]
  sentMessages Message[]      @relation("MessageSender")
  recvMessages Message[]      @relation("MessageRecipient")
  legacy       CaptainLegacy?
  merits       CaptainMerit[]
  chronicles   VoyageChronicle[]
  rivalsA      CaptainRival[]  @relation("RivalA")
  rivalsB      CaptainRival[]  @relation("RivalB")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Room {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  hostId    String
  isPublic  Boolean  @default(true)
  createdAt DateTime @default(now())
  // [I1: the telemetry spine] When the lobby opened for the voyage that is
  // next to sail. createdAt above is the harbor's birthday and never moves,
  // which is the wrong end of the fill time for a table that replays in the
  // same room: a restart reopens the lobby without touching the birthday,
  // so a second voyage's fill time measured from it counts every hour
  // since the room was first chartered. This column is stamped at creation
  // and bumped by the restart (see wiring/restart-voyage.ts), and it is
  // what the telemetry record's openedAt reads at departure.
  lobbyOpenedAt DateTime @default(now())

  currentRound Int    @default(1)
  currentPhase String @default("0")
  voyageEpoch  Int    @default(0)
  // [H5: the quota rung] How many captains the voyage now under way was
  // dealt to, written in the same update that sets `started` and cleared
  // in the one that restarts the voyage. It is the fleet's size as a fact
  // of the voyage rather than of the harbor: membership can change mid
  // voyage, and the rung that scales the commission has to be read from
  // the departure rather than from whoever is still sitting at the table.
  // It sails for both modes because it is a record of the voyage rather
  // than an Ocean Gambit artifact. 0 means the voyage was never pinned,
  // which is what a room whose voyage began before this column existed
  // reads as, and what the rung draws for: the founding deck, unchanged.
  voyageSeats  Int    @default(0)
  started      Boolean @default(false)
  difficulty   String @default("fair_winds")
  // Which voyage this harbor is playing (see src/lib/game/mode.ts). Chosen
  // once, when the room is created, exactly like difficulty: a host picks a
  // mode and every captain resolves the same record. It decides that mode's
  // synchronized phase order, so a captain whose state disagrees with the
  // room is running the right phases in the wrong order. Defaults to the
  // founding mode, which is what every room created before this column
  // existed is playing.
  mode         String @default("classic")
  // [H9: the unlock code] Which phrase opened this harbor, by its id in
  // src/lib/unlock.ts, or the empty string for a room chartered without
  // one. Written once at creation beside difficulty and mode, for the same
  // reason: it is a property of the room rather than of any account, so
  // every captain who reads this room reads the same answer, and a captain
  // who heard the phrase can open the table for the whole crew.
  //
  // The empty string rather than null, and no phrase ever stored here:
  // what a room remembers is which door it opened, never the words that
  // opened it, so a table can be named by the code that made it without
  // carrying a copy of the code around with it.
  unlock       String @default("")

  host           User            @relation("RoomHost", fields: [hostId], references: [id], onDelete: Cascade)
  members        RoomMember[]
  messages       Message[]
  gameStates     GameState[]
  voyageRoles    VoyageRole[]
  convoyVentures ConvoyVenture[]
  loans          Loan[]
  // No back-reference to VoyageChronicle or VoyageTelemetry: both carry
  // roomId as a bare column so their rows outlive the room, and Prisma
  // relations cascade or dangle. See the writeups on each of those models.
  rivals         CaptainRival[]

  @@index([hostId])
}

model RoomMember {
  id       String   @id @default(cuid())
  userId   String
  roomId   String
  joinedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([userId, roomId])
  @@index([roomId])
}

model GameState {
  id        String   @id @default(cuid())
  userId    String
  roomId    String
  data      String
  updatedAt DateTime @updatedAt

  integritySeverity String?
  integrityNote     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([userId, roomId])
  @@index([userId])
  @@index([roomId])
}

// Ocean Gambit: one captain's private card for one voyage, in the one
// place nothing in the interface can read. A card is the alignment they
// were dealt plus, for most of the table, the personal goal it carried.
//
// There is deliberately no client path to this table in either direction.
// It is written once, by the realtime layer, in the same breath as the
// room setting sail, and it is read back only to answer the captain the
// row belongs to. No route, no socket handler and no broadcast takes a
// row from here and hands it to anyone else, which is what the whole
// private information spine is for. It is therefore not a Ledger
// Integrity Pass subject either: that pass guards the one save endpoint
// that trusts a client, and this table is never written by one.
//
// The row is the record rather than a seed to derive from again. A seed
// would have to be kept for the whole voyage, and running it again over
// a roster that gained a captain mid voyage would move every card at
// the table, including the ones already read.
model VoyageRole {
  id       String   @id @default(cuid())
  roomId   String
  userId   String
  // One of the roles in src/lib/game/gambit.ts: honest, pirate, broker.
  role     String
  // The personal goal an Honest card was dealt, by id, out of the flourish
  // deck in src/lib/game/gambit.ts. Null on a hidden card, on a captain
  // who joined a voyage already under way and was handed the majority card
  // without a hand to draw from, and on every row written before this
  // column existed. A nullable addition rather than a table of its own,
  // because a flourish has no life apart from the card it was dealt with.
  flourish String?
  // Write only, on purpose: the moment a role was dealt is a record of
  // when it happened, kept the same way CaptainMerit.earnedAt is, and no
  // reader has needed it yet. Docs: BUFF_AUDIT.md, the deliberate keeps.
  drawnAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId])
  @@index([userId])
}

model CaptainLegacy {
  id               String @id @default(cuid())
  userId           String @unique
  renownLevel      Int    @default(1)
  renownXP         Int    @default(0)
  voyagesCompleted Int    @default(0)
  seaMasterCrowns  Int    @default(0)
  bestScore        Int    @default(0)
  consecutiveSolventVoyages Int @default(0)
  statsByDifficulty String @default("{}")
  checkInCount    Int     @default(0)
  lastCheckInDate String?
  houseId         String?
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CaptainMerit {
  id       String   @id @default(cuid())
  userId   String
  meritId  String
  earnedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, meritId])
  @@index([userId])
}

model ConvoyVenture {
  id               String @id @default(cuid())
  roomId           String
  voyageEpoch      Int
  posterId         String
  posterName       String
  targetGold       Int
  deadlineRound    Int
  payoutMultiplier Float  @default(1.5)
  contributions    String @default("{}")
  status           String @default("open")
  createdAt        DateTime  @default(now())
  // Write only, on purpose: when a venture resolved is a record of when
  // it happened, kept rather than dropped, and no reader has needed it.
  resolvedAt       DateTime?

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, voyageEpoch])
}

model Message {
  id          String   @id @default(cuid())
  roomId      String?
  senderId    String
  recipientId String?
  content     String
  createdAt   DateTime @default(now())

  room      Room? @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender    User  @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User? @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
  @@index([senderId, recipientId, createdAt])
}

model Loan {
  id           String @id
  roomId       String
  voyageEpoch  Int
  borrowerId   String
  borrowerName String
  lenderId     String
  lenderName   String
  amount       Int
  round        Int
  backerId     String?
  backerName   String?
  backedAmount Int?
  redirectToUserId String?
  redirectToName   String?
  createdAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, voyageEpoch])
}

// =====================================================================
// Tables the manifest systems shipped with: the voyage chronicle, the
// captain rivalry record, the telemetry spine and the operator report.
// House Rally is the one manifest system that did not ship a table here.
// =====================================================================

model VoyageChronicle {
  id        String   @id @default(cuid())
  userId    String
  roomId    String
  voyageEpoch Int
  difficulty  String
  rounds      Int
  peakReputation Int
  finalReputation Int
  finalGold       Int
  largestTrade    Int
  lendCount       Int
  borrowCount     Int
  crowned         Boolean @default(false)
  bankrupt        Boolean @default(false)
  // [H7: Maroon and the Harbormaster] Whether the harbor voted this
  // captain ashore. Its own column rather than a comment in the body text
  // because the chronicle viewer tags the row with it and because the
  // epic's evaluation reads maroon outcomes back by query, the same way it
  // reads bankrupt ones. Written from the server's record of the vote, so
  // unlike bankrupt it never depends on what a client reported.
  marooned        Boolean @default(false)
  merchantRating  String
  headline        String
  body            String
  // [H2: the fleet commission] The measurement half of Ocean Gambit's
  // objective, recorded where every other voyage outcome already is.
  // objectiveTrace is JSON text for the same reason GameState.data is: the
  // per leg detail is one document, walked rather than joined, and nothing
  // reads it by query. Its consumer today is the smoke run's fleet
  // commission suite, which asserts a finished voyage's counters; the H2
  // launch gate's evaluation is the reader these columns were built for
  // and it has not landed yet, so no report script parses the trace.
  // A row is per captain, so the total in it is the harbor's as that one
  // client last saw it, and a later pass takes the room's max rather than
  // trusting any single row. Empty in Classic, where no objective is drawn.
  mode            String   @default("classic")
  objectiveId     String   @default("")
  objectiveMet    Boolean  @default(false)
  objectiveTrace  String   @default("")
  // [F7: the combination instrument] The durable cards this captain ended
  // the voyage holding, as a JSON array of ids (the milestone boons, the
  // bolted on modules and the charter). JSON text for the trace's reason:
  // the pair matrix is read by the report script, never by a query, and
  // the ids are resolved through the pool at read time so a retired card
  // falls out of the instrument the same way it falls out of a save. A
  // forged finish writes empty here, the same reading every other
  // measurement from an unreadable save gets.
  heldCards       String   @default("")
  // [H4: the Broker] Whether this captain won their own voyage, decided by
  // evaluateVictory in src/lib/game/victory.ts at the moment the voyage
  // concluded, and the alignment they sailed under, recorded right beside
  // it. Both are private: a chronicle row is read only by the captain it
  // belongs to (see /api/chronicle), and the reveal at the table is a later
  // slice. They are stored here rather than broadcast because the epic's
  // evaluation reads them back: every win rate band in the plan is a query
  // over alignment and won on rows from finished voyages, including the
  // honest side's, which nothing could measure before this column existed.
  // Empty alignment in Classic, where no hand was dealt.
  alignment       String   @default("")
  won             Boolean  @default(false)
  // [H5: the quota rung] How many captains the voyage that wrote this row
  // was dealt to, copied from Room.voyageSeats as the conclusion writes
  // it. The rung scales the commission by that number, so an outcome
  // recorded without it cannot be grouped by table size, and the plan's
  // gate is a claim about table size: the same rate at four, five and six
  // seats. 0 for every voyage that sailed before the rung existed, which
  // reads as the anchor band and is the honest reading of the board those
  // voyages were in fact judged on.
  seats           Int      @default(0)
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // roomId is a bare string with no relation on it, for the reason
  // VoyageTelemetry's is written up with below: a harbor is deleted the
  // moment its last member leaves, which is the ordinary end of an
  // ordinary voyage, and a cascade would erase the very chronicles this
  // table exists to keep. The row belongs to the captain (the user
  // relation above still cascades, so erasing an account takes its own
  // rows), and the room is only the harbor the voyage was sailed in.

  @@index([userId, createdAt])
  @@index([roomId])
}

model CaptainRival {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  roomId    String
  voyageEpoch Int
  // Write only, on purpose: the standings each captain held when the
  // rivalry was sealed, kept as a record beside the outcome flags below.
  aScore    Int
  bScore    Int
  aWon      Boolean @default(false)
  bWon      Boolean @default(false)
  tie       Boolean @default(false)
  createdAt DateTime @default(now())

  userA User @relation("RivalA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("RivalB", fields: [userBId], references: [id], onDelete: Cascade)
  // roomId used to be a bare column, so a rivalry outlived the harbor it was
  // fought in: destroying the room left the row behind, pointing at nothing.
  // A voyage's records are the room's, so it goes when the room goes.
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([userAId, userBId])
  @@index([roomId])
}

// [I1: the telemetry spine] One voyage, as the spine saw it: the record the
// accumulator in src/server/realtime/telemetry.ts writes when a voyage
// stops, however it stops.
//
// The body is JSON text for the same reason GameState.data and
// objectiveTrace are: a record is one document, read whole by a reader that
// walks its events, and never joined against. The columns beside it are the
// header the plan asks to be queryable without opening the document: which
// mode and difficulty the voyage was chartered with, the rung it was judged
// on, how it ended, the leg it ended at, and when it ran. A dashboard that
// wanted "the abandon rate by leg" would group by these rather than parse
// four thousand events per voyage.
//
// One row per voyage, written once. roomId is deliberately a bare string
// with no relation on it, unlike every other room-scoped row in this
// schema, and the reason is written down because it looks like an
// oversight: a room is deleted the moment its last member leaves, which is
// the ordinary end of an ordinary voyage, and the interesting records are
// exactly the ones that end that way. A cascade would erase every voyage
// that concluded and every voyage that emptied out along with the lobby
// nobody is sitting in anymore, which is the whole of what this table is
// for. So the record outlives the harbor it describes, and the one caller
// that must not leave one behind, the account purge, deletes the records of
// the rooms it destroys by hand (see purgeResolved in src/server/realtime/admin.ts).
model VoyageTelemetry {
  id          String   @id @default(cuid())
  roomId      String
  voyageEpoch Int
  mode        String
  difficulty  String
  // The rung, copied from Room.voyageSeats at departure the way the
  // chronicle copies it at conclusion: the seats a voyage sailed with are
  // a fact of that voyage and must not follow a roster that moved on.
  seats       Int
  // The vocabulary version and the sampling rate the voyage ran under, so
  // a later reader knows which build wrote the body and what it is a
  // sample of.
  version     Int
  sampleRate  Float
  // "concluded", "restarted" or "emptied" (TelemetryOutcome in
  // src/lib/game/telemetry.ts). A string rather than an enum for the same
  // reason Room.mode is: the set grows with the vocabulary, and a new
  // outcome must not need a migration to be storable.
  outcome     String
  leg         Int
  startedAt   DateTime
  endedAt     DateTime
  record      String
  createdAt   DateTime @default(now())

  @@index([roomId])
  @@index([endedAt])
}

// [J2: the mute and the report] One captain's report of another, filed from
// the harbor roster and read later by a person rather than by the game.
//
// Three bare strings with no relations on them, and the reasons are written
// down because the shape looks like an oversight next to every other room
// scoped row in this schema.
//
// The room is bare for the reason VoyageTelemetry's is: a harbor is deleted
// the moment its last member leaves, which is the ordinary end of an
// ordinary voyage, and a report filed during that voyage is exactly the one
// worth keeping. A cascade would erase the report along with the lobby
// nobody is sitting in anymore.
//
// The two captains are bare for a second reason on top of that. A report
// names an account, and an account can be erased by the operator. A cascade
// would take the report with it, which is right for the account being
// erased and wrong for the captain who filed it, since what they wrote down
// is also a fact about them. So the purge deletes the reports that name the
// account it is erasing, by hand (see purgeResolved in
// src/server/realtime/admin.ts), and leaves every other report standing.
//
// voyageEpoch is the voyage the report belongs to, read from the room at
// the moment it was filed. In a lobby that is the voyage about to sail from
// it, and a lobby report and a report filed in the voyage that follows are
// one row rather than two, which is honest: they are the same harbor
// session and the same pair of captains.
//
// No reason field, deliberately. The plan puts a moderation console after
// this feature, and a free text field either side of a wire is a field
// nobody has read the private information review for. What the row carries
// is who, about whom, in which voyage, and when, which is what a person
// opening a conversation needs and what a later reader can trust.
model Report {
  id           String   @id @default(cuid())
  roomId       String
  voyageEpoch  Int
  reporterId   String
  targetUserId String
  createdAt    DateTime @default(now())

  // One report per pair per voyage, enforced here rather than in a map: the
  // file is a client frame, a client can repeat it, and the handler must
  // not have to remember what it has already been told.
  @@unique([reporterId, targetUserId, roomId, voyageEpoch])
  @@index([roomId])
  @@index([targetUserId])
  @@index([createdAt])
}
