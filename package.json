{
  "name": "portmasters-2-2-parallel-release",
  "version": "0.4.2",
  "private": true,
  "description": "PortMasters 2.2 Parallel Release: a browser based multiplayer trading game on the maritime Silk Road. One npm project serves the site, the API and the realtime channel on a single port.",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "prisma generate && tsx scripts/tags.ts && tsx scripts/cards.ts && tsx scripts/status.ts && next build",
    "start": "NODE_ENV=production tsx server.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:closed-test": "tsx scripts/closed-test.ts",
    "check:palette": "tsx scripts/palette.ts",
    "check:tags": "tsx scripts/tags.ts",
    "check:cards": "tsx scripts/cards.ts",
    "check:status": "tsx scripts/status.ts",
    "check:private": "tsx scripts/private-scan.ts",
    "report:bands": "tsx scripts/bands.ts",
    "report:gates": "tsx scripts/gates.ts",
    "report:cards": "tsx scripts/cardConversion.ts",
    "report:modules": "tsx scripts/moduleTrades.ts",
    "report:milestones": "tsx scripts/milestoneBoons.ts",
    "report:pairs": "tsx scripts/pairs.ts",
    "test:smoke": "tsx scripts/smoke/index.ts",
    "db:push": "prisma db push",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.11.1",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.2",
    "lucide-react": "^0.525.0",
    "next": "^16.1.1",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "prisma": "^6.11.1",
    "tailwindcss": "^4",
    "tsx": "^4.20.0",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5"
  }
}
